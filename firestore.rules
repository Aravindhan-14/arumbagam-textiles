rules_version = '2';

/* ============================================================
   VYRA SAREES - Firestore security rules
   ------------------------------------------------------------
   Everyone who reaches the data must be a signed-in user whose
   users/{uid} profile exists and is active. Admins have full
   access; staff are limited by the permission flags an admin
   sets on their profile.

   What the shop paid for its stock is deliberately NOT stored on
   the product. It lives in product_costs/{productId}, which only
   an admin can read - so a staff phone never receives the cost
   price at all, not even inside the network payload. Suppliers
   and purchases sit behind the same wall for the same reason.

   Bootstrap: while settings/business does not exist yet, the
   first signed-in account may create its own admin profile and
   the business document. Saving settings closes that window.
   ============================================================ */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isActive() {
      return hasProfile() && profile().status == 'active';
    }
    function isAdmin() {
      return isActive() && profile().role == 'admin';
    }
    function isStaff() {
      return isActive();
    }
    /* Admins implicitly hold every permission. */
    function can(p) {
      return isAdmin() || (isActive() && profile().permissions[p] == true);
    }
    /* Open only until the business document is written. */
    function bootstrap() {
      return signedIn() && !exists(/databases/$(database)/documents/settings/business);
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /* ---------------- users ---------------- */
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin() || bootstrap();

      // The first account on a fresh project becomes the admin; later
      // self-registrations land as inactive staff until an admin activates
      // them, and an admin can create an account outright.
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid && bootstrap()
            && request.resource.data.role == 'admin')
        || (signedIn() && request.auth.uid == uid && !bootstrap()
            && request.resource.data.role == 'staff'
            && request.resource.data.status == 'inactive');

      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && changedKeys().hasOnly(['lastLoginAt', 'updatedAt', 'name']));

      allow delete: if isAdmin();
    }

    /* ---------------- catalogue ---------------- */
    match /products/{id} {
      allow read: if isStaff();
      allow create: if can('products.create');
      // Billing and returns move stock, so any active user may touch the
      // stock counter; everything else needs the edit permission.
      allow update: if can('products.edit')
        || (isStaff() && changedKeys().hasOnly(['stock', 'updatedAt']));
      allow delete: if can('products.delete');
    }

    match /product_variants/{id} {
      allow read: if isStaff();
      allow write: if can('products.edit');
    }

    /* What we paid. Owner only - a staff device never receives these.
       Note it is NOT a field on the product: every staff device reads
       products, so a purchase price kept there would be handed straight
       to them. That is why this collection exists. */
    match /product_costs/{id} {
      allow read, write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if isStaff();
      allow write: if can('categories.manage');
    }

    /* ---------------- people ---------------- */
    match /customers/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    /* Suppliers reveal who we buy from and at what price. Owner only. */
    match /suppliers/{id} {
      allow read, write: if isAdmin();
    }

    /* ---------------- transactions ---------------- */
    match /sales/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.staffId == request.auth.uid;
      // Only cancellation and return bookkeeping may alter a saved bill.
      allow update: if can('sales.cancel')
        || (isStaff() && changedKeys().hasOnly(['hasReturn', 'returnedAmount', 'updatedAt']));
      allow delete: if false;      // bills are cancelled, never deleted
    }

    /* Purchases carry the buying rate, so they follow the cost wall. */
    match /purchases/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /returns/{id} {
      allow read: if isStaff();
      allow create: if can('returns.create');
      allow update, delete: if false;
    }

    /* ---------------- audit trails ---------------- */
    match /stock_history/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /activity_log/{id} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    /* ---------------- settings ---------------- */
    match /settings/business {
      allow read: if signedIn();
      allow write: if can('settings.manage') || bootstrap();
    }

    // Document-number counters: every biller needs to reserve a block.
    match /settings/counters {
      allow read, write: if isStaff() || bootstrap();
    }

    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    /* Everything else is closed. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
